rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isApprovedEmployee() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function validTarget(km) {
      return km == 5 || km == 10 || km == 15 ||
             km == 20 || km == 25 || km == 30;
    }

    function validSevenDayGoal() {
      return request.resource.data.selectedAt is timestamp
        && request.resource.data.lockedUntil is timestamp
        && request.resource.data.lockedUntil
           == request.resource.data.selectedAt + duration.value(7, 'd');
    }

    // Public connection status only; OAuth tokens live in server-only stravaTokens.
    match /stravaConnections/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /stravaTokens/{uid} { allow read, write: if false; }
    match /stravaOAuthStates/{id} { allow read, write: if false; }
    match /stravaAthletes/{id} { allow read, write: if false; }
    match /stravaEvents/{id} { allow read, write: if false; }
    match /stravaActivities/{id} {
      allow get: if isApprovedEmployee() || isAdmin();
      allow list: if isApprovedEmployee() || isAdmin();
      allow create, update, delete: if false;
    }
    match /clubDeclarations/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isApprovedEmployee() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.selfDeclared == true;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /joinRequests/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.status == 'pending'
        );

      allow delete: if false;
    }

    match /members/{uid} {
      allow get: if signedIn()
        && (
          request.auth.uid == uid ||
          isApprovedEmployee() ||
          isAdmin()
        );

      // Required for leaderboard, department race and Community Journey.
      allow list: if isApprovedEmployee() || isAdmin();

      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Legacy manual goals and submissions remain readable for historical audit only.
    match /weeklyChallenges/{challengeId} {
      allow get: if isApprovedEmployee() || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /submissions/{submissionId} {
      allow get, list: if isAdmin() || (isApprovedEmployee() && resource.data.employeeUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /campaign/{docId} {
      allow read: if isApprovedEmployee() || isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
